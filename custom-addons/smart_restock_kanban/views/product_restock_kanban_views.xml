<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_product_restock_kanban_view" model="ir.ui.view">
        <field name="name">product.product.restock.kanban</field>
        <field name="model">product.product</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stock_status"
                    records_draggable="false"
                    groups_draggable="false">
                <field name="id"/>
                <field name="name"/>
                <field name="default_code"/>
                <field name="qty_available"/>
                <field name="days_of_stock"/>
                <field name="stock_status"/>
                <field name="uom_id"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div t-if="record.default_code.value">
                                <small>[<field name="default_code"/>]</small>
                            </div>
                            <div>
                                On Hand: <field name="qty_available"/> <field name="uom_id"/>
                            </div>
                            <div>
                                Days: <field name="days_of_stock"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="product_product_restock_search_view" model="ir.ui.view">
        <field name="name">product.product.restock.search</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <search string="Search Products">
                <field name="name"/>
                <field name="default_code"/>
                <field name="categ_id"/>
            </search>
        </field>
    </record>
</odoo>
